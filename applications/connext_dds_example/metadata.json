{
  "application": {
    "name": "Connext DDS Example",
    "description": "End-to-end example using generic RTI Connext DDS Holoscan publisher and subscriber operators with an application-defined IDL type.",
    "authors": [
      {
        "name": "Real-Time Innovations, Inc.",
        "affiliation": "Real-Time Innovations, Inc."
      }
    ],
    "language": "Python",
    "dockerfile": "modules/holoscan-connext-dds/Dockerfile",
    "version": "1.0.0",
    "changelog": {
      "1.0": "Initial release."
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["DDS", "RTI Connext", "Networking and Distributed Computing"],
    "holoscan_sdk": {
      "minimum_required_version": "4.5.0",
      "tested_versions": ["4.5.0"]
    },
    "ranking": 2,
    "requirements": {
      "operators": [
        {
          "name": "connext_dds",
          "version": "1.0"
        }
      ]
    },
    "run": {
      "command": "python3 <holohub_app_source>/connext_dds_example.py",
      "workdir": "holohub_app_bin"
    }
  }
}
