{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "sipl_stereo_monitor",
        "authors": [
            {
                "name": "Gil Shapira",
                "affiliation": "NVIDIA"
            }
        ],
        "description": "Drives two SIPLCaptureOp instances against one shared SIPLCaptureService, reporting per-camera frame counts, cross-camera sync skew, and stereo-sync stalls",
        "language": "C++",
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Initial implementation"
        },
        "holoscan_sdk": {
            "minimum_required_version": "5.0.0",
            "tested_versions": ["5.0.0"]
        },
        "platforms": ["aarch64"],
        "tags": ["Camera", "CUDA", "SIPL", "Jetson", "IGX", "Early Access"],
        "ranking": 3,
        "requirements": {
            "required": ["NvSIPL dev packages (NvSIPLCamera.hpp)", "Two-sensor VB1940 stereo rig"]
        },
        "default_mode": "run",
        "modes": {
            "run": {
                "description": "Stream from both sensors and report a stall if either goes quiet",
                "run": {
                    "command": "\"<holohub_app_bin>/sipl_stereo_monitor\"",
                    "workdir": "holohub_app_bin"
                }
            }
        }
    }
}
