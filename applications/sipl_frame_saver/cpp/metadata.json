{
    "$schema": "urn:holohub:application:v1",
    "application": {
        "name": "sipl_frame_saver",
        "authors": [
            {
                "name": "Gil Shapira",
                "affiliation": "NVIDIA"
            }
        ],
        "description": "Captures frames from a SIPL camera and saves raw buffers with text sidecars for offline inspection",
        "language": "C++",
        "version": "0.1.0",
        "changelog": {
            "0.1.0": "Initial implementation"
        },
        "holoscan_sdk": {
            "minimum_required_version": "5.0.0",
            "tested_versions": ["5.0.0"]
        },
        "platforms": ["aarch64"],
        "tags": ["Camera", "CUDA", "SIPL", "Jetson", "IGX", "Early Access"],
        "ranking": 3,
        "requirements": {
            "required": ["NvSIPL dev packages (NvSIPLCamera.hpp)"]
        },
        "default_mode": "run",
        "modes": {
            "run": {
                "description": "Capture frames from a SIPL camera and save them to disk",
                "run": {
                    "command": "\"<holohub_app_bin>/sipl_frame_saver\"",
                    "workdir": "holohub_app_bin"
                }
            }
        }
    }
}
