{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "v4l2_depth",
    "authors": [
      {
        "name": "Holoscan Team",
        "affiliation": "NVIDIA"
      }
    ],
    "description": "Live V4L2 video with a latched Depth Anything V2 overlay using the native Holoscan SDK 5.x typed-tensor API",
    "language": "C++",
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Initial SDK 5.x native-tensor port"
    },
    "dockerfile": "applications/v4l2_depth/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": [
      "Camera",
      "Computer Vision and Perception",
      "CUDA",
      "Depth Estimation",
      "TensorRT",
      "Visualization"
    ],
    "ranking": 2,
    "requirements": {
      "hardware": [
        {
          "name": "V4L2 camera",
          "description": "Required for live mode: a camera that can capture packed YUYV at the selected resolution and frame rate",
          "required": false
        },
        {
          "name": "NVIDIA GPU",
          "description": "CUDA-capable GPU supported by Holoscan SDK 5.x and TensorRT",
          "required": true
        },
        {
          "name": "X11 display",
          "description": "Required for live and loopback visualization: an accessible X11 display for the output window",
          "required": false
        }
      ],
      "operators": [
        {
          "name": "bgra_to_planar_tensor",
          "version": "0.1.0"
        },
        {
          "name": "cuda_compositor",
          "version": "0.1.0"
        },
        {
          "name": "depth_colorizer",
          "version": "0.1.0"
        },
        {
          "name": "frame_skipper",
          "version": "0.1.0"
        },
        {
          "name": "tensorrt_inference",
          "version": "0.1.0"
        },
        {
          "name": "v4l2_source",
          "version": "0.1.0"
        },
        {
          "name": "x11_display",
          "version": "0.1.0"
        },
        {
          "name": "yuyv_to_bgra",
          "version": "0.1.0"
        }
      ],
      "models": [
        {
          "name": "Depth Anything V2 Small",
          "license": "Apache-2.0",
          "source": "https://huggingface.co/depth-anything/Depth-Anything-V2-Small"
        }
      ]
    },
    "default_mode": "validate",
    "modes": {
      "live": {
        "description": "Capture /dev/video0, infer depth on every other frame, and display the live overlay",
        "build": {
          "docker_build_args": ["--target", "v4l2-depth-live"],
          "cmake_options": ["-DV4L2_DEPTH_PREPARE_MODEL=ON"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_depth\" --data-dir \"<holohub_data_dir>/v4l2_depth\"",
          "workdir": "holohub_bin"
        }
      },
      "loopback": {
        "description": "Loop the fixed-path H.264 test video through /dev/video42 as aspect-preserving 1280x720 progressive YUYV at 25 FPS without padding, then run the complete depth pipeline",
        "build": {
          "docker_build_args": ["--target", "v4l2-depth-loopback"],
          "cmake_options": ["-DV4L2_DEPTH_PREPARE_MODEL=ON"]
        },
        "run": {
          "command": "\"<holohub_app_source>/../scripts/run_v4l2_depth_loopback.py\" --feeder \"<holohub_app_source>/../scripts/feed_v4l2_loopback.py\" --application \"<holohub_app_bin>/v4l2_depth\" --data-dir \"<holohub_data_dir>/v4l2_depth\" --video \"<holohub_data_dir>/v4l2_depth/5823544-hd_1920_1080_25fps.mp4\" --",
          "workdir": "holohub_bin"
        }
      },
      "validate": {
        "description": "Compile the complete graph without opening the camera, model, or display",
        "build": {
          "docker_build_args": ["--target", "v4l2-depth-validate"],
          "cmake_options": ["-DV4L2_DEPTH_PREPARE_MODEL=OFF"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_depth\" --data-dir \"<holohub_data_dir>/v4l2_depth\" --validate",
          "workdir": "holohub_bin"
        }
      }
    }
  }
}
