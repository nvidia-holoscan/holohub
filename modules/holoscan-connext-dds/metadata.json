{
  "$schema": "holoscan/module/v2",
  "module": {
    "name": "holoscan-connext-dds",
    "version": "1.0.0",
    "description": "RTI Connext DDS operators and examples for NVIDIA Holoscan",
    "authors": [{
      "name": "RTI Real Time Innovations",
      "affiliation": "RTI Real Time Innovations"
    }],
    "license": "Apache-2.0",
    "language": ["C++", "Python"],
    "namespace": {
      "cpp": "holoscan::ops",
      "python": "holohub.dds"
    },
    "operator_names": [
      "ConnextDDSPublisherOp",
      "ConnextDDSSubscriberOp",
      "DDSShapesSubscriberOp",
      "DDSVideoPublisherOp",
      "DDSVideoSubscriberOp"
    ],
    "subprojects": {
      "operators": [
        "dds_pubsub",
        "dds_shapes_subscriber",
        "dds_video_publisher",
        "dds_video_subscriber"
      ],
      "applications": [
        "connext_dds_publisher",
        "connext_dds_roundtrip",
        "connext_dds_subscriber",
        "dds_video"
      ]
    },
    "holoscan_sdk": {
      "minimum_required_version": "4.6.0",
      "tested_versions": ["4.6.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["DDS", "RTI Connext", "Networking and Distributed Computing"],
    "requirements": {
      "system_packages": [
        "ca-certificates",
        "curl",
        "openjdk-21-jre",
        "v4l-utils",
        "xauth",
        "xvfb"
      ],
      "python_packages": ["rti.connext==7.7.0", "pytest"]
    },
    "binary_packages": {},
    "dockerfile": "modules/holoscan-connext-dds/Dockerfile",
    "documentation": {"readme": "README.md"},
    "testing": {"python": "pytest"}
  }
}
