{
  "tutorial": {
    "name": "Cross Compilation Example",
    "description": "Cross-compile a minimal Holoscan C++ application for Jetson AGX Thor and IGX Thor",
    "authors": [
      {
        "name": "Zachary Crandall",
        "affiliation": "NVIDIA"
      }
    ],
    "language": "C++",
    "version": "1.0",
    "changelog": {
      "1.0": "Initial release"
    },
    "holoscan_sdk": {
      "minimum_required_version": "4.6.0",
      "tested_versions": [
        "4.6.0"
      ]
    },
    "platforms": [
      "x86_64"
    ],
    "tags": [
      "Hello World",
      "Cross Compilation",
      "IGX Thor",
      "Jetson AGX Thor"
    ],
    "ranking": 4,
    "requirements": {
      "gxf_extensions": []
    },
    "dockerfile": "tutorials/cross_compilation_example/Dockerfile",
    "default_mode": "cross_compile",
    "modes": {
      "cross_compile": {
        "description": "Build the AArch64 example in the x86_64 cross-compilation container",
        "build": {
          "docker_build_args": [
            "--platform",
            "linux/amd64"
          ],
          "cmake_options": [
            "-DCMAKE_TOOLCHAIN_FILE=/opt/holoscan-cross/aarch64-cross-sbsa.cmake"
          ]
        },
        "run": {
          "command": "file <build_dir>/tutorials/cross_compilation_example/cross_compilation_example",
          "workdir": "<holohub_root>",
          "docker_run_args": [
            "--runtime",
            "runc",
            "--platform",
            "linux/amd64"
          ]
        }
      }
    }
  }
}
