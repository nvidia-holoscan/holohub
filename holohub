#
# Holoscan 5.0 EA Samples CLI wrapper.
# Delegates to the standalone `holoscan-cli` package with module-specific
# defaults baked in, defaulting to NVIDIA PyPI release-candidate-capable
# install args.
#
# Usage:
#   ./holohub run-container
#   ./holohub build v4l2_depth
#   ./holohub run   v4l2_depth
#   ./holohub --help
#
# Optional overrides (rarely needed):
#   HOLOSCAN_SDK_INSTALL_DIR  Absolute path to an installed Holoscan SDK.
#   HOLOSCAN_SDK_ROOT         SDK install directory or parent containing one.
#   HOLOSCAN_CLI_SOURCE   Local checkout — wins over the package install.
#   HOLOSCAN_CLI_INSTALL_ARGS  Pip install arguments.
#   HOLOSCAN_CLI_PYTHON_BIN  Caller-owned Python interpreter.
#   HOLOSCAN_CLI_VENV         Wrapper-managed venv location.

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

# ==============================================================================
# Module identity — defaults consumed by holoscan-cli
# ==============================================================================

# HOLOSCAN_CLI_ROOT: the CLI uses this as the project root for cmake -S and container paths.
export HOLOSCAN_CLI_ROOT="${HOLOSCAN_CLI_ROOT:-${SCRIPT_DIR}}"
# HOLOSCAN_CLI_CMD_NAME: shown in help output and error messages.
export HOLOSCAN_CLI_CMD_NAME="${HOLOSCAN_CLI_CMD_NAME:-${BASH_SOURCE[0]}}"
# HOLOSCAN_CLI_REPO_PREFIX: base for naming build dirs, images, etc.
export HOLOSCAN_CLI_REPO_PREFIX="${HOLOSCAN_CLI_REPO_PREFIX:-holoscan_5_0_ea_samples}"
# HOLOSCAN_CLI_CONTAINER_PREFIX: Docker image name prefix.
export HOLOSCAN_CLI_CONTAINER_PREFIX="${HOLOSCAN_CLI_CONTAINER_PREFIX:-holoscan-5-0-ea-samples}"
# HOLOSCAN_CLI_WORKSPACE_NAME: directory name inside the container at /workspace/.
export HOLOSCAN_CLI_WORKSPACE_NAME="${HOLOSCAN_CLI_WORKSPACE_NAME:-holoscan-5-0-ea-samples}"
# HOLOSCAN_CLI_HOSTNAME_PREFIX: container hostname prefix.
export HOLOSCAN_CLI_HOSTNAME_PREFIX="${HOLOSCAN_CLI_HOSTNAME_PREFIX:-holoscan-5-0-ea-samples}"

# ==============================================================================
# Paths
# ==============================================================================

case "$(uname -m)" in
    x86_64|amd64)
        _sdk_arch="x86_64"
        ;;
    aarch64|arm64)
        _sdk_arch="aarch64"
        ;;
    *)
        echo "[holoscan_5_0_ea_samples] Unsupported architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

export HOLOSCAN_CLI_DEFAULT_DOCKERFILE="${HOLOSCAN_CLI_DEFAULT_DOCKERFILE:-${SCRIPT_DIR}/Dockerfile}"
# Use the architecture-specific development image built from the local SDK's
# public/Dockerfile. Callers can override this with --base-img or the variable.
export HOLOSCAN_CLI_BASE_IMAGE="${HOLOSCAN_CLI_BASE_IMAGE:-holoscan-sdk-build-${_sdk_arch}:latest}"
export HOLOSCAN_CLI_BASE_IMAGE_FORMAT="${HOLOSCAN_CLI_BASE_IMAGE_FORMAT:-{base_image}}"

_is_holoscan_install() {
    local candidate="$1"
    [[ -d "${candidate}/lib" ]] &&
        [[ -f "${candidate}/lib/cmake/holoscan/holoscan-config.cmake" ||
           -f "${candidate}/lib/cmake/holoscan/HoloscanConfig.cmake" ]]
}

# Prefer a direct, caller-provided installation tree. HOLOSCAN_SDK_ROOT remains
# compatible with Holoscan CLI and may name either that tree or a parent
# containing install-<arch>. Container commands mount the selected tree at the
# stable /workspace/holoscan-sdk path.
if [[ -f /.dockerenv || -f /run/.containerenv ]]; then
    if _is_holoscan_install "/workspace/holoscan-sdk"; then
        export HOLOSCAN_SDK_ROOT="/workspace/holoscan-sdk"
        _default_hsdk_dir="/workspace/holoscan-sdk"
    elif _is_holoscan_install "/workspace/holoscan-sdk/install-${_sdk_arch}"; then
        export HOLOSCAN_SDK_ROOT="/workspace/holoscan-sdk"
        _default_hsdk_dir="/workspace/holoscan-sdk/install-${_sdk_arch}"
    else
        _default_hsdk_dir="/opt/nvidia/holoscan"
    fi
elif [[ -n "${HOLOSCAN_SDK_INSTALL_DIR:-}" ]]; then
    if [[ "${HOLOSCAN_SDK_INSTALL_DIR}" != /* ]]; then
        echo "[holoscan_5_0_ea_samples] HOLOSCAN_SDK_INSTALL_DIR must be absolute." >&2
        exit 1
    fi
    if ! _is_holoscan_install "${HOLOSCAN_SDK_INSTALL_DIR}"; then
        echo "[holoscan_5_0_ea_samples] Invalid Holoscan SDK installation:" \
             "${HOLOSCAN_SDK_INSTALL_DIR}" >&2
        exit 1
    fi
    export HOLOSCAN_SDK_ROOT="${HOLOSCAN_SDK_INSTALL_DIR}"
    _default_hsdk_dir="${HOLOSCAN_SDK_INSTALL_DIR}"
elif [[ -n "${HOLOSCAN_SDK_ROOT:-}" ]]; then
    if _is_holoscan_install "${HOLOSCAN_SDK_ROOT}"; then
        _default_hsdk_dir="${HOLOSCAN_SDK_ROOT}"
    elif _is_holoscan_install "${HOLOSCAN_SDK_ROOT}/install-${_sdk_arch}"; then
        _default_hsdk_dir="${HOLOSCAN_SDK_ROOT}/install-${_sdk_arch}"
    else
        echo "[holoscan_5_0_ea_samples] HOLOSCAN_SDK_ROOT does not contain a valid" \
             "Holoscan SDK installation: ${HOLOSCAN_SDK_ROOT}" >&2
        exit 1
    fi
elif _is_holoscan_install "${SCRIPT_DIR}/../holoscan-sdk/install-${_sdk_arch}"; then
    # The SDK and early-access samples are commonly checked out as siblings.
    # Auto-discover that layout so the documented `./holohub run <app>`
    # command remains argument-free after the SDK has been built.
    _default_hsdk_dir="$(
        cd "${SCRIPT_DIR}/../holoscan-sdk/install-${_sdk_arch}" && pwd
    )"
    export HOLOSCAN_SDK_ROOT="${_default_hsdk_dir}"
elif _is_holoscan_install "${SCRIPT_DIR}/../holoscan-sdk/public/install-${_sdk_arch}"; then
    # Compatibility with pre-staging main-5x source trees.
    _default_hsdk_dir="$(
        cd "${SCRIPT_DIR}/../holoscan-sdk/public/install-${_sdk_arch}" && pwd
    )"
    export HOLOSCAN_SDK_ROOT="${_default_hsdk_dir}"
else
    _default_hsdk_dir="/opt/nvidia/holoscan"
fi
export HOLOSCAN_CLI_DEFAULT_HSDK_DIR="${HOLOSCAN_CLI_DEFAULT_HSDK_DIR:-${_default_hsdk_dir}}"
export holoscan_ROOT="${holoscan_ROOT:-${HOLOSCAN_CLI_DEFAULT_HSDK_DIR}}"
unset _default_hsdk_dir
unset _sdk_arch
# Recursive discovery includes the collection-level descriptor plus each
# operator and application descriptor.
export HOLOSCAN_CLI_SEARCH_PATH="${HOLOSCAN_CLI_SEARCH_PATH:-./}"
export HOLOSCAN_CLI_BUILD_PARENT_DIR="${HOLOSCAN_CLI_BUILD_PARENT_DIR:-${SCRIPT_DIR}/build}"
export HOLOSCAN_CLI_DATA_DIR="${HOLOSCAN_CLI_DATA_DIR:-${SCRIPT_DIR}/data}"
# A relative path resolves in the repository root on both the host and the
# mounted container workspace.
export HOLOSCAN_CLI_CTEST_SCRIPT="${HOLOSCAN_CLI_CTEST_SCRIPT:-cmake/container.ctest}"

# ==============================================================================
# Build defaults
# ==============================================================================

export CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}"

# ==============================================================================
# holoscan-cli bootstrap + exec
# ==============================================================================

export HOLOSCAN_CLI_INSTALL_ARGS="${HOLOSCAN_CLI_INSTALL_ARGS:---pre --extra-index-url https://pypi.nvidia.com holoscan-cli[create]>4.2.0}"
# Single bump point for the CLI version everywhere (host, images, runtime);
# keep in sync with the HoloHub repo wrapper.
HOLOSCAN_CLI_DEFAULT_PIN="4.5.0rc1"
export HOLOSCAN_CLI_PINNED_VERSION="${HOLOSCAN_CLI_PINNED_VERSION-${HOLOSCAN_CLI_DEFAULT_PIN}}"
CLI_VENV_EXPLICIT="${HOLOSCAN_CLI_VENV:+1}"
if [[ -z "${HOLOSCAN_CLI_VENV:-}" && -n "${XDG_DATA_HOME:-}${HOME:-}" ]]; then
    HOLOSCAN_CLI_VENV="${XDG_DATA_HOME:-${HOME}/.local/share}/holoscan-cli/venv"
fi
export HOLOSCAN_CLI_VENV="${HOLOSCAN_CLI_VENV:-}"

# Default Holoscan SDK version for this module's container base image.
# holoscan-cli decoupled the base image from its own version (holoscan-cli#177)
# and no longer ships a built-in default, so it errors unless this is set (or
# --base-img is passed). Defaults to the module's holoscan_version.
export HOLOSCAN_CLI_BASE_SDK_VERSION="${HOLOSCAN_CLI_BASE_SDK_VERSION:-5.0.0}"

if [[ -n "${HOLOSCAN_CLI_SOURCE:-}" ]]; then
    export PYTHONPATH="${HOLOSCAN_CLI_SOURCE%/}/src${PYTHONPATH:+:${PYTHONPATH}}"
fi

_cli_ok() {
    local python="$1"
    if [[ -n "${HOLOSCAN_CLI_PINNED_VERSION}" && -z "${HOLOSCAN_CLI_SOURCE:-}" ]]; then
        [[ "$("${python}" -c 'from importlib.metadata import version; print(version("holoscan-cli"))' 2>/dev/null)" \
            == "${HOLOSCAN_CLI_PINNED_VERSION}" ]] &&
            "${python}" -c 'import cookiecutter, jsonschema, referencing' 2>/dev/null
    else
        "${python}" -m holoscan_cli --help 2>/dev/null | grep -qw build &&
            "${python}" -c 'import cookiecutter, jsonschema, referencing' 2>/dev/null
    fi
}
_is_container() {
    [[ -f /.dockerenv || -f /run/.containerenv || -f /run/systemd/container ]] ||
        grep -Eq '(docker|containerd|kubepods|podman|buildkit)' /proc/1/cgroup 2>/dev/null
}
_managed_venv_ready() {
    [[ -n "${HOLOSCAN_CLI_VENV}" && -x "${HOLOSCAN_CLI_VENV}/bin/python" ]] &&
        "${HOLOSCAN_CLI_VENV}/bin/python" -m pip --version >/dev/null 2>&1
}
_use_managed_venv() {
    if [[ -z "${HOLOSCAN_CLI_VENV}" ]]; then
        echo "[holoscan_5_0_ea_samples] Set HOME, XDG_DATA_HOME, or HOLOSCAN_CLI_VENV." >&2
        exit 1
    fi
    if ! python3 -m venv "${HOLOSCAN_CLI_VENV}"; then
        echo "[holoscan_5_0_ea_samples] Could not create ${HOLOSCAN_CLI_VENV}; install python3-venv." >&2
        exit 1
    fi
    PYTHON_BIN="${HOLOSCAN_CLI_VENV}/bin/python"
}

PYTHON_BIN="${HOLOSCAN_CLI_PYTHON_BIN:-${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}}"
if [[ -z "${PYTHON_BIN}" ]]; then
    unset PYTHONHOME
fi
if [[ -n "${PYTHON_BIN}" ]]; then
    :
elif [[ "${EUID}" -eq 0 ]] && _is_container; then
    PYTHON_BIN="python3"
    export PIP_BREAK_SYSTEM_PACKAGES="${PIP_BREAK_SYSTEM_PACKAGES:-1}"
elif _managed_venv_ready; then
    PYTHON_BIN="${HOLOSCAN_CLI_VENV}/bin/python"
elif [[ -n "${CLI_VENV_EXPLICIT}" ]]; then
    _use_managed_venv
elif _is_container && [[ -z "${HOLOSCAN_CLI_SOURCE:-}" ]] && _cli_ok python3; then
    PYTHON_BIN="python3"
elif _is_container; then
    echo "[holoscan_5_0_ea_samples] This container lacks holoscan-cli" \
         "${HOLOSCAN_CLI_PINNED_VERSION:+==${HOLOSCAN_CLI_PINNED_VERSION}}; rebuild the image." >&2
    exit 1
else
    _use_managed_venv
fi

if ! _cli_ok "${PYTHON_BIN}"; then
    if ! "${PYTHON_BIN}" -m pip --version >/dev/null 2>&1; then
        "${PYTHON_BIN}" -m ensurepip --upgrade >/dev/null 2>&1 || {
            echo "[holoscan_5_0_ea_samples] ${PYTHON_BIN} has no pip and ensurepip is unavailable;" \
                 "install pip or set HOLOSCAN_CLI_PYTHON_BIN to an interpreter that has it" \
                 "and retry" >&2
            exit 1
        }
    fi
    if [[ -n "${HOLOSCAN_CLI_SOURCE:-}" ]]; then
        echo "[holoscan_5_0_ea_samples] installing holoscan-cli from ${HOLOSCAN_CLI_SOURCE}" >&2
        "${PYTHON_BIN}" -m pip install --upgrade "${HOLOSCAN_CLI_SOURCE}"
    else
        echo "[holoscan_5_0_ea_samples] installing with args: ${HOLOSCAN_CLI_INSTALL_ARGS}" >&2
        "${PYTHON_BIN}" -m pip install ${HOLOSCAN_CLI_INSTALL_ARGS} \
            ${HOLOSCAN_CLI_PINNED_VERSION:+"holoscan-cli[create]==${HOLOSCAN_CLI_PINNED_VERSION}"} || {
            _is_container && echo "[holoscan_5_0_ea_samples] Install failed in this" \
                "container; rebuild the image (./holohub build-container)." >&2
            exit 1
        }
    fi
fi

# Containers re-enter through this mounted wrapper so the pinned CLI version
# is verified at runtime.
export HOLOSCAN_CLI_IN_CONTAINER_CMD="${HOLOSCAN_CLI_IN_CONTAINER_CMD:-./${BASH_SOURCE[0]##*/}}"

# The 5.0 EA SDK is a CUDA 13 build. Holoscan CLI otherwise derives its
# default from the host driver, which can select an incompatible CUDA 12
# project image. Add the project default only to commands that accept the
# container build option, and preserve an explicit caller override.
CLI_ARGS=("$@")
case "${1:-}" in
    build|build-container|run|run-container|test)
        _has_cuda_arg=false
        for _arg in "${CLI_ARGS[@]}"; do
            if [[ "${_arg}" == "--cuda" || "${_arg}" == --cuda=* ]]; then
                _has_cuda_arg=true
                break
            fi
        done
        if [[ "${_has_cuda_arg}" == false ]]; then
            CLI_ARGS+=(--cuda 13)
        fi
        unset _arg
        unset _has_cuda_arg
        ;;
esac

# Keep subprocesses launched by the CLI (including system-language pre-commit
# hooks) on the interpreter that bootstrapped Holoscan CLI. Container images
# can otherwise resolve `python3` from /usr/local/bin even when the CLI is
# running with /usr/bin/python3.
PYTHON_BIN="$(command -v "${PYTHON_BIN}")"
export HOLOSCAN_CLI_PYTHON_BIN="${PYTHON_BIN}"
export PATH="${PYTHON_BIN%/*}:${PATH}"

# exec so signals reach the CLI directly; `python -m` avoids resolving a
# different `holoscan` console script from PATH.
exec "${PYTHON_BIN}" -m holoscan_cli "${CLI_ARGS[@]}"
