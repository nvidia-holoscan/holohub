@PACKAGE_INIT@

# A consumer that has not already configured the SDK (e.g. the module's Debian package installed
# beside it) needs the holoscan::core / holoscan::sensor_io imported targets the exports link.
if(NOT TARGET holoscan::core)
    include(CMakeFindDependencyMacro)
    find_dependency(holoscan 5.0.0 COMPONENTS core sensor_io)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@ARG_EXPORT_NAME@.cmake")
check_required_components(@ARG_NAME@)
